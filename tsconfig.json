{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "mayacharts": ["./src/index.ts"],
      "mayacharts/element": ["./src/element.ts"],
      "mayacharts/hierarchy": ["./src/hierarchy.ts"],
      "mayacharts/flow": ["./src/flow.ts"],
      "mayacharts/geo": ["./src/geo.ts"],
      "mayacharts/radial": ["./src/radial.ts"],
      "mayacharts/stats": ["./src/stats.ts"],
      "mayacharts/global": ["./src/global.ts"],
      "mayacharts/jsx": ["./src/jsx.d.ts"]
    },
    "noEmit": true
  },
  "include": ["src", "test", "e2e", "site", "scripts", "*.ts"]
}
