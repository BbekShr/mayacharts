{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bbekshr.github.io/mayacharts/schema.json",
  "title": "mayaCharts spec",
  "type": "object",
  "required": ["type", "data", "y"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Ignored; lets editors and LLMs find the JSON schema."
    },
    "type": {
      "type": "string",
      "enum": [
        "bar",
        "line",
        "area",
        "scatter",
        "heatmap",
        "waterfall",
        "kpi",
        "dumbbell",
        "ridgeline",
        "beeswarm",
        "parallel",
        "table",
        "treemap",
        "sunburst",
        "sankey",
        "chord",
        "marimekko",
        "waffle",
        "radial",
        "hexmap"
      ],
      "description": "Chart type. ridgeline, beeswarm, parallel, table are core. treemap, sunburst, marimekko, waffle need `mayacharts/hierarchy`; sankey, chord need `mayacharts/flow`; radial needs `mayacharts/radial`; hexmap needs `mayacharts/geo`."
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Row objects."
    },
    "aggregate": {
      "type": "string",
      "enum": ["sum", "mean", "count", "min", "max"],
      "default": "sum",
      "description": "How rows sharing a (category, series) combine. `count` counts non-null y."
    },
    "sort": {
      "type": "string",
      "enum": ["asc", "desc"],
      "description": "Order categories by total across all series (hidden ones too)."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "description": "Keep the top N categories by total; the rest roll up into a final \"Other\"."
    },
    "x": {
      "type": "string",
      "description": "Category field (scatter: numeric x; hexmap: US state). Not used by path types."
    },
    "xType": {
      "type": "string",
      "enum": ["auto", "category", "time"],
      "default": "auto",
      "description": "How x is spaced. \"auto\": a time axis when every x is an ISO 8601 date (\"2024-03\" or longer) on line, area or vertical bar without sort or limit; else categories. \"time\" also accepts epoch ms numbers."
    },
    "y": {
      "oneOf": [
        {
          "type": "string",
          "description": "Value field."
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "An array adds a measure toggle, first one active."
        }
      ]
    },
    "y2": {
      "type": "string",
      "description": "Second value field, drawn as a line on a right axis over the bars. Vertical bar only."
    },
    "series": {
      "type": "string",
      "description": "Splits rows into series (heatmap: the row category; dumbbell: exactly two, from and to). bar line area scatter heatmap dumbbell."
    },
    "path": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Hierarchy fields, outer to inner. treemap sunburst sankey; bar/line/area/dumbbell with `drill` (replaces `x`)."
    },
    "size": {
      "type": "string",
      "description": "Bubble area field (sqrt scale). scatter only."
    },
    "name": {
      "type": "string",
      "description": "Point identity and tooltip title. scatter only."
    },
    "totals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "x values drawn as running-total bars. waterfall only."
    },
    "stack": {
      "type": "boolean",
      "description": "Stack series instead of grouping them. bar and area only."
    },
    "horizontal": {
      "type": "boolean",
      "description": "Categories on the left axis. bar and dumbbell."
    },
    "format": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "auto",
            "integer",
            "decimal",
            "compact",
            "percent",
            "currency",
            "date",
            "month",
            "year",
            "time",
            "datetime"
          ],
          "description": "A preset for every `y`."
        },
        {
          "type": "string",
          "pattern": "^[^{}]*\\{value(?::(?:auto|integer|decimal|compact|percent|currency|date|month|year|time|datetime))?\\}[^{}]*$",
          "maxLength": 80,
          "description": "A template string with `{value}` or `{value:preset}`."
        },
        {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "auto",
                  "integer",
                  "decimal",
                  "compact",
                  "percent",
                  "currency",
                  "date",
                  "month",
                  "year",
                  "time",
                  "datetime"
                ]
              },
              {
                "type": "string",
                "pattern": "^[^{}]*\\{value(?::(?:auto|integer|decimal|compact|percent|currency|date|month|year|time|datetime))?\\}[^{}]*$",
                "maxLength": 80
              },
              {
                "type": "object",
                "properties": {
                  "prefix": {
                    "type": "string"
                  },
                  "suffix": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            ]
          },
          "description": "A preset / template / Intl options per field. Display only."
        }
      ],
      "description": "Display format for values."
    },
    "titles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Display names by field: axis titles (shown only when set), tooltip, legend, table."
    },
    "labels": {
      "type": "boolean",
      "description": "Formatted values on marks. Default false (heatmap: true when cells are ≥ 24 px)."
    },
    "text": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Localised UI strings with `{0}` placeholders.",
      "propertyNames": {
        "enum": [
          "noData",
          "other",
          "back",
          "reset",
          "showing",
          "drilledInto",
          "zoomedTo",
          "selected",
          "selectionCleared",
          "chartOf",
          "chartOfAll",
          "firstOf",
          "measures",
          "crumbs",
          "positive",
          "negative",
          "above",
          "below",
          "vs",
          "ofTarget",
          "total",
          "shareOf",
          "sortedBy",
          "ascending",
          "descending",
          "fromTo",
          "reduced",
          "points"
        ]
      }
    },
    "locale": {
      "type": "string",
      "default": "en-US",
      "description": "BCP 47 locale for formatting."
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "ISO 4217 code for the \"currency\" preset."
    },
    "title": {
      "type": "string",
      "description": "Visible heading, also the accessible name."
    },
    "description": {
      "type": "string",
      "description": "Accessible description; auto-generated when omitted."
    },
    "yDomain": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "Fixed value-axis domain. Not allowed with a `y` array."
    },
    "xDomain": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "Fixed x domain. scatter only."
    },
    "tooltip": {
      "type": "boolean",
      "default": true,
      "description": "Hover/keyboard tooltip."
    },
    "legend": {
      "type": "boolean",
      "description": "Legend; clicking toggles series. Default: true when `series` is set."
    },
    "drill": {
      "type": "boolean",
      "description": "Click/Enter zooms into a branch of `path`; breadcrumb, Back and Escape pop."
    },
    "drillOut": {
      "type": "boolean",
      "description": "With `drill`: a click on empty chart space goes back up one level. Default true."
    },
    "select": {
      "oneOf": [
        {
          "type": "boolean",
          "enum": [true]
        },
        {
          "type": "string",
          "enum": ["multi"]
        }
      ],
      "description": "Click/Enter/legend selects marks, others dim; Escape clears. Not with `drill`."
    },
    "zoom": {
      "type": "boolean",
      "description": "Drag to zoom. line, area, scatter. Reset chip, double-click and Escape restore."
    },
    "animate": {
      "type": "boolean",
      "default": true,
      "description": "Animate the first draw and every update (element only; off under reduced motion)."
    },
    "colors": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "description": "Palette in series order (max 8)."
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Colours by series value.",
          "maxProperties": 8
        }
      ],
      "description": "Palette or colours by series value."
    },
    "colorBy": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["sign"]
        },
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "number"
            }
          },
          "required": ["target"],
          "additionalProperties": false
        },
        {
          "type": "string",
          "description": "A numeric field.",
          "minLength": 1
        }
      ],
      "description": "Tone by sign of y, by a target, or a ramp by a numeric field. Not with `series`."
    },
    "theme": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Theme token overrides (CSS values, allowlisted).",
      "propertyNames": {
        "enum": [
          "font",
          "fontSize",
          "fg",
          "fgMuted",
          "grid",
          "bg",
          "accent",
          "radius",
          "tooltipBg",
          "tooltipFg",
          "focus",
          "good",
          "bad",
          "series1",
          "series2",
          "series3",
          "series4",
          "series5",
          "series6",
          "series7",
          "series8"
        ]
      }
    },
    "grid": {
      "type": "boolean",
      "default": true,
      "description": "Grid lines perpendicular to the value axis."
    },
    "xAxis": {
      "type": "boolean",
      "default": true,
      "description": "Bottom axis."
    },
    "yAxis": {
      "type": "boolean",
      "default": true,
      "description": "Left axis."
    },
    "table": {
      "type": "boolean",
      "default": true,
      "description": "Visually hidden data table for screen readers."
    }
  }
}
