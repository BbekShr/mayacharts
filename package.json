{
  "name": "mayacharts",
  "version": "0.15.0",
  "description": "Beautiful, accessible charts in five lines. Zero dependencies. The browser is the chart engine.",
  "keywords": [
    "chart",
    "charts",
    "svg",
    "web-component",
    "custom-element",
    "dataviz",
    "ssr",
    "charts-library",
    "data-visualization",
    "accessibility",
    "a11y",
    "wcag",
    "csp",
    "trusted-types",
    "zero-dependency",
    "d3-alternative",
    "sankey",
    "treemap",
    "heatmap",
    "json-schema"
  ],
  "license": "MIT",
  "author": "Bibek Shrestha",
  "homepage": "https://bbekshr.github.io/mayacharts/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BbekShr/mayacharts.git"
  },
  "bugs": "https://github.com/BbekShr/mayacharts/issues",
  "funding": "https://bbekshr.github.io/mayacharts/support/",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./hierarchy": {
      "types": "./dist/hierarchy.d.ts",
      "default": "./dist/hierarchy.js"
    },
    "./flow": {
      "types": "./dist/flow.d.ts",
      "default": "./dist/flow.js"
    },
    "./geo": {
      "types": "./dist/geo.d.ts",
      "default": "./dist/geo.js"
    },
    "./radial": {
      "types": "./dist/radial.d.ts",
      "default": "./dist/radial.js"
    },
    "./stats": {
      "types": "./dist/stats.d.ts",
      "default": "./dist/stats.js"
    },
    "./weave": {
      "types": "./dist/weave.d.ts",
      "default": "./dist/weave.js"
    },
    "./units": {
      "types": "./dist/units.d.ts",
      "default": "./dist/units.js"
    },
    "./orbit": {
      "types": "./dist/orbit.d.ts",
      "default": "./dist/orbit.js"
    },
    "./constellation": {
      "types": "./dist/constellation.d.ts",
      "default": "./dist/constellation.js"
    },
    "./themes": {
      "types": "./dist/themes.d.ts",
      "default": "./dist/themes.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./global": "./dist/maya.global.js",
    "./theme.css": "./dist/theme.css",
    "./schema.json": "./schema.json",
    "./jsx": {
      "types": "./dist/jsx.d.ts"
    }
  },
  "sideEffects": [
    "./dist/element.js",
    "./dist/hierarchy.js",
    "./dist/flow.js",
    "./dist/geo.js",
    "./dist/radial.js",
    "./dist/stats.js",
    "./dist/weave.js",
    "./dist/units.js",
    "./dist/orbit.js",
    "./dist/constellation.js",
    "./dist/maya.global.js",
    "./dist/maya.*.global.js",
    "./src/element.ts",
    "./src/hierarchy.ts",
    "./src/flow.ts",
    "./src/radial.ts",
    "./src/weave.ts",
    "./src/units.ts",
    "./src/orbit.ts",
    "./src/constellation.ts",
    "./src/geo.ts",
    "./src/stats.ts",
    "./src/global.ts",
    "./src/global-*.ts"
  ],
  "files": [
    "dist",
    "schema.json",
    "llms.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "readme:shots": "node scripts/readme-shots.mjs",
    "dev": "node scripts/ssr-demo.ts && vite --config site/vite.config.ts",
    "build": "vite build --mode index && vite build --mode element && vite build --mode hierarchy && vite build --mode flow && vite build --mode geo && vite build --mode radial && vite build --mode stats && vite build --mode weave && vite build --mode units && vite build --mode orbit && vite build --mode constellation && vite build --mode host && vite build --mode themes && vite build --mode global && vite build --mode global-core && vite build --mode global-hierarchy && vite build --mode global-flow && vite build --mode global-geo && vite build --mode global-radial && vite build --mode global-stats && vite build --mode global-weave && vite build --mode global-units && vite build --mode global-orbit && vite build --mode global-constellation && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-webkit",
    "site:build": "node scripts/ssr-demo.ts && vite build --config site/vite.config.ts",
    "tokens": "node scripts/tokens.mjs"
  },
  "mayaSize": {
    "dist/index.js": 40560,
    "dist/element.js": 58260,
    "dist/theme.css": 4800,
    "dist/hierarchy.js": 4450,
    "dist/flow.js": 3900,
    "dist/geo.js": 3584,
    "dist/radial.js": 4780,
    "dist/stats.js": 4050,
    "dist/maya.global.js": 77930,
    "dist/weave.js": 2560,
    "dist/units.js": 2560,
    "dist/orbit.js": 2600,
    "dist/constellation.js": 3100,
    "dist/themes.js": 1800
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "esbuild": "0.28.2",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
