  "skills": {
    "ponytail": {
      "agents": ["maya-core-engineer", "maya-chart-designer", "maya-element-engineer"],
      "when": "before writing any code, level full",
      "fallback": "say so in the report and apply the ponytail rules in CLAUDE.md"
    },
    "anthropic-skills:taste-skill": {
      "agents": ["maya-chart-designer", "maya-design-critic", "maya-motion-critic"],
      "when": "before any visual or motion change, and as the critics' grading bar",
      "fallback": "say so in the report and grade against the comparison set and the Bar lessons in learnings/_shared.md"
    },
    "dataviz": {
      "agents": ["maya-chart-designer", "maya-design-critic"],
      "when": "before choosing a form, colours, marks or labels",
      "fallback": "say so and work from the chart rules in learnings/_shared.md"
    },
    "design:accessibility-review": {
      "agents": ["maya-design-critic"],
      "when": "WCAG 2.2 AA pass on changed charts",
      "fallback": "say so and run e2e/a11y.spec.ts plus the manual contrast checks in the agent's method"
    },
    "anthropic-skills:built-in-browser": {
      "agents": ["maya-repro"],
      "when": "driving the gallery to reproduce a report",
      "fallback": "use a throwaway Playwright script as /maya-verify describes"
    },
    "ponytail-review": {
      "agents": [],
      "ceo": true,
      "when": "full diff before the final gate, every apply run",
      "fallback": "review the diff for deletions yourself and say so"
    },
    "ponytail-audit": {
      "agents": [],
      "ceo": true,
      "when": "deep mode",
      "fallback": "skip and say so"
    },
    "ponytail-debt": {
      "agents": [],
      "ceo": true,
