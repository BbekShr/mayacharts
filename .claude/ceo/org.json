  "autonomy_level": "L1",
  "autonomy_target": "L1",
  "models": { "top": "opus", "mid": "sonnet", "small": "haiku" },
  "gates": [
    { "name": "typecheck", "cmd": "npm run typecheck", "when": "always", "cheap": true },
    { "name": "format", "cmd": "npx prettier --check .", "when": "always", "cheap": true },
    { "name": "unit", "cmd": "npm test", "when": "always", "cheap": true },
    {
      "name": "build",
      "cmd": "npm run build",
      "when": "always",
      "note": "writes dist/: one build per tree at a time"
    },
    {
      "name": "size",
      "cmd": "npm run size",
      "when": "always",
      "note": "after build; budgets in package.json mayaSize"
    },
    {
      "name": "e2e",
      "cmd": "npm run e2e",
      "when": "src/**, site/** or e2e/** changed",
      "note": "chromium, firefox, webkit, mobile-webkit; binds a port"
    },
    {
      "name": "feature-check",
      "cmd": "",
      "when": "always",
      "note": "supplied by the CEO's brief per item"
    }
  ],
  "gate_files": [],
  "gate_files_note": "Guarded by the existing .claude/hooks/guard.mjs (gates mode): tsconfig.json, vitest.config.ts, playwright.config.ts, size.mjs, theme.test.ts, .prettierrc, .prettierignore and the mayaSize budgets in package.json. Kept there so two hooks never do the same job.",
  "protected_paths": [
    "CLAUDE.md",
    "LICENSE",
    "STABILITY.md",
    "package.json",
    ".github/workflows/**",
    ".githooks/**",
    "tsconfig.json",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/size.mjs",
    "test/theme.test.ts",
    ".prettierrc",
    ".prettierignore",
    ".claude/ceo/org.json",
    ".claude/ceo/AUTONOMY.md",
    ".claude/settings.json",
    ".claude/hooks/**",
    ".claude/skills/maya-release/**",
    ".claude/skills/maya-deploy/**"
  ],
  "user_data_paths": [],
