    {
      "name": "maya-chart-designer",
      "access": "editor",
      "role": "frontend-engineer",
      "perimeter": [
        "src/core/marks/**",
        "src/hierarchy.ts",
        "src/flow.ts",
        "src/geo.ts",
        "src/radial.ts",
        "src/stats.ts",
        "src/weave.ts",
        "src/units.ts",
        "src/orbit.ts",
        "src/constellation.ts",
        "src/themes.ts",
        "src/styles/**",
        "site/**",
        "e2e/__screenshots__/**"
